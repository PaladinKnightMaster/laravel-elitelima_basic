# Copy to .env in the repository root on the server, then fill in.
#
#   cp deploy/.env.production.example .env
#
# compose reads this file, so these values reach the containers. Everything the
# application itself needs is set in deploy/compose.prod.yaml; what lives here
# is the handful of secrets and the domain.

# Must resolve to this host, with 80 and 443 reachable, or Caddy cannot get a
# certificate. Use localhost to trial the stack without a domain.
SITE_DOMAIN=example.com

# Generate once and keep it. Changing it invalidates every session and every
# encrypted cookie:
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=

# Used by both the app and the db container to create the database on
# first boot. Pick real values before the first `up`: MySQL only applies them
# when it initialises an empty data volume.
DB_DATABASE=elitelima
DB_USERNAME=elitelima
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Optional: publish the app on a different host port in development.
APP_PORT=8000
